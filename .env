# System Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_USER=harvest_admin
DB_PASSWORD=harvest_secure_pass123
DB_HOST=db
DB_NAME=harvest_db
DB_PORT=5432

# Third Party APIs
TVDB_API_KEY=5b88a422-2213-4b6a-ac22-bdf94fa65453

# ---------------------------------------------------------------------------
# Plex Media Server (cross-reference matched catalog against your library)
# Append these to your existing .env — do not commit real values.
# ---------------------------------------------------------------------------

# Base URL of your Plex server. Since the backend runs inside Docker, this
# must be an address reachable from the container's network — NOT
# "localhost" (that would point at the container itself). Use the LAN IP
# or hostname of the machine running Plex, e.g.:
PLEX_SERVER_URL=http://192.168.50.119:32400

# Long-lived Plex auth token (X-Plex-Token). See:
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=Sd6h51onaSnkxnvajy4K

# Optional: restrict sync to one specific library section id instead of
# every TV/Movie section on the server. Find section ids via:
#   GET {PLEX_SERVER_URL}/library/sections?X-Plex-Token={PLEX_TOKEN}
# Leave blank to auto-sync all sections of that type.
PLEX_TV_SECTION_ID=
PLEX_MOVIE_SECTION_ID=

# ---------------------------------------------------------------------------
# qBittorrent WebUI (used by the "Download Magnet" buttons to push a magnet
# straight to your torrent client instead of just linking to it)
# Docs: https://github.com/qbittorrent/qBittorrent/wiki/WebUI-API-(qBittorrent-5.0)#add-new-torrent
# ---------------------------------------------------------------------------

# Base URL of your qBittorrent WebUI. Since the backend runs inside Docker,
# this must be an address reachable from the container's network — NOT
# "localhost" (that would point at the container itself). Use the LAN IP
# or hostname of the machine running qBittorrent, e.g.:
QBITTORRENT_URL=http://192.168.50.158:8080

# WebUI login credentials (Tools > Options > WebUI in qBittorrent). Not
# needed if "Bypass authentication for clients on localhost" is enabled AND
# the backend runs on the same host as qBittorrent — otherwise required.
QBITTORRENT_USERNAME=btadmin
QBITTORRENT_PASSWORD=btpassword

# Category assigned to a torrent depending on where "Download Magnet" was
# clicked from: an episode/season-pack card uses the TV category, a movie
# card uses the movie category. Categories are created automatically by
# qBittorrent if they don't already exist.
QBITTORRENT_CATEGORY_TV=tv
QBITTORRENT_CATEGORY_MOVIES=movies