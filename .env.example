# System Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_USER=harvest_admin
DB_PASSWORD=harvest_secure_pass123
DB_HOST=db
DB_NAME=harvest_db
DB_PORT=5432

# Third Party APIs
TVDB_API_KEY=

# ---------------------------------------------------------------------------
# Plex Media Server (cross-reference matched catalog against your library)
# Append these to your existing .env — do not commit real values.
# ---------------------------------------------------------------------------

# Base URL of your Plex server. Since the backend runs inside Docker, this
# must be an address reachable from the container's network — NOT
# "localhost" (that would point at the container itself). Use the LAN IP
# or hostname of the machine running Plex, e.g.:
PLEX_SERVER_URL=http://192.168.1.50:32400

# Long-lived Plex auth token (X-Plex-Token). See:
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=

# Optional: restrict sync to one specific library section id instead of
# every TV/Movie section on the server. Find section ids via:
#   GET {PLEX_SERVER_URL}/library/sections?X-Plex-Token={PLEX_TOKEN}
# Leave blank to auto-sync all sections of that type.
PLEX_TV_SECTION_ID=
PLEX_MOVIE_SECTION_ID=